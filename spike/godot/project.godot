; Progetto Godot minimo per confrontare la grafica del GLB di Moglia.
; Generare prima il modello con: npm run glb
config_version=5

[application]

config/name="Moglia City - Godot load spike"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.66, 0.8, 0.9, 1)
