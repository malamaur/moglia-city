; Progetto Godot minimo per misurare il caricamento di moglia.glb.
; Generare prima il modello con: npm run glb
config_version=5

[application]

config/name="Moglia City - Godot load spike"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[rendering]

renderer/rendering_method="forward_plus"
